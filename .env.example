# Port of the web UI on the host.
PORT=8097

# Everything below is optional: the connection to qBittorrent is set up in the
# web UI on first start.

# Network of the qBit Lite container. Change it only if it clashes with yours.
QBIT_LITE_SUBNET=172.31.250.0/24

# Live move progress: qBittorrent's folders, mounted read-only.
# Host folder, and the path qBittorrent sees it as.
QBIT_MEDIA_HOST=
QBIT_MEDIA_PATH=
QBIT_INCOMPLETE_HOST=
QBIT_INCOMPLETE_PATH=

# Skip the setup wizard and configure the connection here instead.
QBIT_URL=
QBIT_USERNAME=
QBIT_PASSWORD=
QBIT_AUTH_BYPASS=false
